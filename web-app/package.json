{
  "name": "ccb-to-sui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --outDir dist-web",
    "build:standalone": "tsc -b && vite build --mode standalone",
    "preview": "vite preview --outDir dist-web",
    "verify:refunds": "esbuild scripts/verify-refunds.ts --bundle --platform=node --format=esm --outfile=node_modules/.verify-refunds.mjs --log-level=warning && node node_modules/.verify-refunds.mjs"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.7.52",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
